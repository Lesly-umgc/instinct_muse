# Engine: "opencode_server" (default, uses your local OpenCode CLI login - no
# API key needed) or "zen_api" (direct OpenCode Zen API key).
DEFAULT_ENGINE=opencode_server

# Only needed for the zen_api engine:
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
MODEL=big-pickle

# OpenCode server: leave empty to auto-spawn `opencode serve` when the CLI is
# detected. Set to point at a server you run yourself.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_PORT=4096

# Local state (SQLite):
DATA_DIR=~/.instinct_muse

# Server deploy only (docker-compose):
DATABASE_URL=postgresql://muse:muse@localhost:5432/muse
EGRESS_ALLOWLIST=opencode.ai
