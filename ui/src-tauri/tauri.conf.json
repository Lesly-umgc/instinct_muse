{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instinct Muse",
  "version": "0.1.0",
  "identifier": "dev.instinctmuse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Instinct Muse",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
