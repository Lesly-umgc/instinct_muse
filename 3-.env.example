# Model provider: OpenCode Zen (https://opencode.ai/docs/zen/)
MODEL_PROVIDER=opencode_zen
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Free Zen model to start with; swap for any /chat/completions model id
MODEL=big-pickle

DATABASE_URL=postgresql://muse:muse@localhost:5432/muse
BROKER_SOCKET=/run/muse/broker.sock
EGRESS_ALLOWLIST=api.github.com,www.googleapis.com,opencode.ai
